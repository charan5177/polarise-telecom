# Polarise Telecom Technology — Environment Variables
APP_NAME="Polarise Telecom Technology"
CLIENT_NAME="Polaris Educational Consultancy"
ENVIRONMENT=development

# Security
SECRET_KEY=polarise-production-secret-key-change-this-value
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database (SQLite by default, set postgresql://user:pass@host/dbname for Production)
DATABASE_URL=sqlite:///./polarise_telecom.db

# Telephony Configuration
# Set DEMO_MODE=false when integrating with live Exotel credentials
DEMO_MODE=true
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_VIRTUAL_NUMBER=+918047190000
EXOTEL_WEBHOOK_SECRET=your_webhook_auth_secret_token
